{
  "uid": "dbadmin-backend",
  "title": "DBAdmin Backend",
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU Usage",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"backend\"}",
          "legendFormat": "process",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "JVM Heap Used",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "heap used",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active DB Connections",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"backend\"}",
          "legendFormat": "active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_uptime_seconds{application=\"backend\"}",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Request Rate (req/s by endpoint)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"backend\"}[1m])) by (uri, method)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Error Rate (%)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "5xx error rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Average Request Latency (ms by endpoint)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1000 * sum(rate(http_server_requests_seconds_sum{application=\"backend\"}[5m])) by (uri) / sum(rate(http_server_requests_seconds_count{application=\"backend\"}[5m])) by (uri)",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM Heap Used vs Max",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "max",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HikariCP Connections",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"backend\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"backend\"}",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"backend\"}",
          "legendFormat": "pending",
          "refId": "C"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "JVM Threads (live / daemon / peak)",
      "description": "Kac thread var. Trafikle orantisiz, surekli tirmanan bir live cizgisi thread leak isaretidir; peak ile arasindaki fark da o ana kadar gorulen en yuksek noktayi gosterir.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"backend\"}",
          "legendFormat": "live",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"backend\"}",
          "legendFormat": "daemon",
          "refId": "B"
        },
        {
          "expr": "jvm_threads_peak_threads{application=\"backend\"}",
          "legendFormat": "peak",
          "refId": "C"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "JVM Threads by State",
      "description": "Thread'ler ne yapiyor. Toplam ayni kalirken blocked/waiting katmaninin buyumesi darbogaz demektir (lock beklemesi ya da tukenen bir havuz); ustteki panelde bu tek cizgi olarak gorunmez.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "jvm_threads_states_threads{application=\"backend\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "JVM GC Pause Time (avg ms, by cause)",
      "description": "Bir GC durup dunyayi ne kadar bekletiyor. Sayi degil sure onemli: kisa/sik pause'lar genelde normal, uzayan/seyrek buyuk pause'lar uygulamayi donduran (stop-the-world) bir soruna isaret eder.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1000 * rate(jvm_gc_pause_seconds_sum{application=\"backend\"}[5m]) / rate(jvm_gc_pause_seconds_count{application=\"backend\"}[5m])",
          "legendFormat": "{{action}} ({{cause}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Tables Active",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dbadmin_tables_active{application=\"backend\"}",
          "legendFormat": "tables",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Schemas Active",
      "gridPos": {
        "x": 4,
        "y": 44,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dbadmin_schemas_active{application=\"backend\"}",
          "legendFormat": "schemas",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Tables Created (total)",
      "gridPos": {
        "x": 8,
        "y": 44,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dbadmin_tables_creations_total{application=\"backend\"}",
          "legendFormat": "created",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Tables Deleted (total)",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dbadmin_tables_deletions_total{application=\"backend\"}",
          "legendFormat": "deleted",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Columns Created (total)",
      "gridPos": {
        "x": 16,
        "y": 44,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dbadmin_columns_creations_total{application=\"backend\"}",
          "legendFormat": "created",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Schemas Created (total)",
      "gridPos": {
        "x": 20,
        "y": 44,
        "w": 4,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dbadmin_schemas_creations_total{application=\"backend\"}",
          "legendFormat": "created",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Redis Cache Hit Rate (%) - kullanici rol",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(rate(dbadmin_cache_rol_hits_total[5m])) / (sum(rate(dbadmin_cache_rol_hits_total[5m])) + sum(rate(dbadmin_cache_rol_misses_total[5m])))",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Cache Hits (total)",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 6,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dbadmin_cache_rol_hits_total{application=\"backend\"}",
          "legendFormat": "hits",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Cache Misses (total)",
      "gridPos": {
        "x": 18,
        "y": 48,
        "w": 6,
        "h": 4
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "dbadmin_cache_rol_misses_total{application=\"backend\"}",
          "legendFormat": "misses",
          "refId": "A"
        }
      ]
    }
  ]
}